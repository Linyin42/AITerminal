/* ============================================================
   AITerminal 暗色主题 —— Midnight Indigo
   靛蓝强调色 + 带靛蓝调的深色层次（非纯灰）
   参考 2026 主流开发者工具配色（Linear / GitHub Dark 系）
   ============================================================ */

* {
    font-family: "Microsoft YaHei", "PingFang SC", "Segoe UI", sans-serif;
    font-size: 13px;
    color: #e6e9f2;
    outline: none;
}

QMainWindow {
    background-color: #12141c;
}

/* ---------------------------------------------------------- 停靠面板 */
QDockWidget {
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
    border: none;
    font-weight: bold;
}

QDockWidget#VaultDock {
    background-color: #181b26;
}

QDockWidget#AIDock {
    background-color: #12141c;
}

QDockWidget::title {
    background: transparent;
    padding: 0;
    border: none;
    height: 0;
}

/* ---------------------------------------------------------- 工具栏 */
QToolBar {
    background: #171a24;
    border: none;
    border-bottom: 1px solid #2b3143;
    spacing: 6px;
    padding: 6px 8px;
}

QToolBar QToolButton {
    color: #c5cddd;
    background: #1e222f;
    border: 1px solid #2b3143;
    padding: 5px 12px;
    border-radius: 6px;
}

QToolBar QToolButton:hover {
    background: #262b3a;
    border-color: #39415a;
}

QToolBar QToolButton:pressed,
QToolBar QToolButton:checked {
    background: rgba(124, 140, 248, 0.16);
    border-color: #7c8cf8;
    color: #a5b1ff;
}

/* ---------------------------------------------------------- 标签页 */
QTabWidget::pane {
    border: none;
    background: transparent;
    top: 1px;
}

QTabBar::tab {
    background: transparent;
    color: #98a1b5;
    padding: 9px 18px;
    border: none;
    border-bottom: 2px solid transparent;
    margin-right: 2px;
}

QTabBar::tab:selected {
    color: #e6e9f2;
    border-bottom: 2px solid #7c8cf8;
    background: rgba(124, 140, 248, 0.08);
}

QTabBar::tab:hover:!selected {
    color: #c5cddd;
}

QTabBar::close-button {
    image: none;
    subcontrol-position: right;
}

/* ---------------------------------------------------------- 状态栏 */
QStatusBar {
    background: #171a24;
    color: #98a1b5;
    border-top: 1px solid #2b3143;
}

QStatusBar QLabel {
    color: #98a1b5;
    padding: 0 8px;
}

/* ---------------------------------------------------------- 输入控件 */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background: #171a24;
    color: #e6e9f2;
    border: 1px solid #2b3143;
    border-radius: 7px;
    padding: 5px 8px;
    selection-background-color: rgba(124, 140, 248, 0.3);
}

QLineEdit:focus, QSpinBox:focus, QComboBox:focus,
QPlainTextEdit:focus, QTextEdit:focus {
    border-color: #7c8cf8;
}

QComboBox::drop-down {
    border: none;
    width: 18px;
}

QComboBox QAbstractItemView {
    background: #1e222f;
    color: #e6e9f2;
    border: 1px solid #2b3143;
    selection-background-color: rgba(124, 140, 248, 0.18);
}

QTextEdit, QPlainTextEdit {
    background: #171a24;
    color: #e6e9f2;
    border: 1px solid #2b3143;
    border-radius: 7px;
    selection-background-color: rgba(124, 140, 248, 0.3);
}

/* ---------------------------------------------------------- 按钮 */
QPushButton {
    background: #1e222f;
    color: #e6e9f2;
    border: 1px solid #2b3143;
    border-radius: 7px;
    padding: 6px 14px;
    min-height: 18px;
}

QPushButton:hover {
    background: #262b3a;
    border-color: #39415a;
}

QPushButton:pressed {
    background: #171a24;
}

QPushButton[primary="true"] {
    background: #7c8cf8;
    border: none;
    color: #12141c;
    font-weight: bold;
}

QPushButton[primary="true"]:hover {
    background: #98a5ff;
}

QPushButton[primary="true"]:pressed {
    background: #5f6fe8;
}

QPushButton:disabled {
    color: #5a6274;
    background: #171a24;
    border-color: #232839;
}

/* ---------------------------------------------------------- 分组框 */
QGroupBox {
    border: 1px solid #2b3143;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 12px;
    background: #171a24;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    color: #a5b1ff;
    font-weight: bold;
    background: #12141c;
}

/* ---------------------------------------------------------- 列表 */
QListWidget, QListView, QTreeView, QTableView {
    background: #171a24;
    color: #e6e9f2;
    border: 1px solid #2b3143;
    border-radius: 8px;
    alternate-background-color: #1c202c;
    selection-background-color: rgba(124, 140, 248, 0.18);
    outline: 0;
}

QListWidget::item:hover {
    background: #242938;
}

QHeaderView::section {
    background: #1e222f;
    color: #98a1b5;
    border: none;
    border-bottom: 1px solid #2b3143;
    padding: 6px;
}

/* ---------------------------------------------------------- 菜单 */
QMenuBar {
    background: #171a24;
    color: #e6e9f2;
}

QMenuBar::item:selected {
    background: #262b3a;
}

QMenu {
    background: #1e222f;
    color: #e6e9f2;
    border: 1px solid #2b3143;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 5px 16px;
    border-radius: 4px;
}

QMenu::item:selected {
    background: rgba(124, 140, 248, 0.18);
    color: #a5b1ff;
}

QMenu::separator {
    height: 1px;
    background: #2b3143;
    margin: 4px 8px;
}

/* ---------------------------------------------------------- 滚动条 */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #343a4d;
    min-height: 28px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #454c63;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #343a4d;
    min-width: 28px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background: #454c63;
}

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
}

/* ---------------------------------------------------------- 复选框 */
QCheckBox {
    color: #c5cddd;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #39415a;
    border-radius: 4px;
    background: #171a24;
}

QCheckBox::indicator:checked {
    background: #7c8cf8;
    border-color: #7c8cf8;
}

/* ---------------------------------------------------------- 提示 */
QToolTip {
    background: #1e222f;
    color: #e6e9f2;
    border: 1px solid #2b3143;
    border-radius: 6px;
    padding: 5px 8px;
}

/* ---------------------------------------------------------- 对话区 */
QTextBrowser {
    background: #12141c;
    border: 1px solid #2b3143;
    border-radius: 8px;
}

/* ---------------------------------------------------------- 设备库面板 */
QLabel#VaultTitle {
    color: #e6e9f2;
    font-weight: bold;
    font-size: 15px;
}

QLabel#VaultCount {
    color: #98a1b5;
    font-size: 11px;
}

QLabel#VaultSection {
    color: #a5b1ff;
    font-size: 11px;
    font-weight: bold;
    padding: 2px 0;
}

QLabel#VaultHint {
    color: #666e82;
    font-size: 10px;
}

QLineEdit#VaultSearch {
    background: #12141c;
    border: 1px solid #2b3143;
    border-radius: 6px;
    padding: 4px 8px;
    color: #e6e9f2;
    font-size: 12px;
}

QLineEdit#VaultSearch:focus {
    border-color: #7c8cf8;
}

QPushButton#VaultPrimaryBtn {
    background: #7c8cf8;
    color: #12141c;
    border: none;
    border-radius: 6px;
    padding: 4px 12px;
    font-weight: bold;
    min-height: 16px;
}

QPushButton#VaultPrimaryBtn:hover {
    background: #98a5ff;
}

QPushButton#VaultPrimaryBtn:pressed {
    background: #5f6fe8;
}

QScrollArea#VaultScroll {
    background: transparent;
    border: none;
}

QWidget#VaultCardsHost {
    background: transparent;
}