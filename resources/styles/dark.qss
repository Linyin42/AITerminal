/* ============================================================
   AITerminal 暗色主题 —— 仿 Netcatty 设计系统
   参考 binaricat/Netcatty 的 index.css：
     · 大圆角（卡片 12px / 控件 8px / 小件 6px）
     · 极细滚动条（muted-fg/0.18）
     · 焦点环（primary 描边）
     · 字重 550/650（medium / semibold）
     · hover 用 foreground/0.1 叠加而非固定色
   配色：靛蓝 Indigo（主色 #7c8cf8）+ 靛调深色层次
   ============================================================ */

* {
    font-family: "Mona Sans", "Segoe UI Variable Display", "Segoe UI",
                 "Microsoft YaHei UI", "Microsoft YaHei", system-ui, sans-serif;
    font-size: 13px;
    color: #e6e9f2;
    outline: none;
}

QMainWindow {
    background-color: #12141c;
}

/* ---------------------------------------------------------- 停靠面板 */
QDockWidget {
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
    border: none;
}

QDockWidget#VaultDock {
    background-color: #171a24;
}

QDockWidget#AIDock {
    background-color: #12141c;
}

QDockWidget::title {
    background: transparent;
    padding: 0;
    border: none;
    height: 0;
}

/* ---------------------------------------------------------- 工具栏 */
QToolBar {
    background: #171a24;
    border: none;
    border-bottom: 1px solid #2b3143;
    spacing: 6px;
    padding: 7px 10px;
}

QToolBar QToolButton {
    color: #c5cddd;
    background: transparent;
    border: 1px solid transparent;
    padding: 5px 11px;
    border-radius: 8px;
    font-weight: 550;
}

QToolBar QToolButton:hover {
    background: rgba(230, 233, 242, 0.08);
}

QToolBar QToolButton:pressed,
QToolBar QToolButton:checked {
    background: rgba(124, 140, 248, 0.16);
    border-color: rgba(124, 140, 248, 0.55);
    color: #a5b1ff;
}

/* ---------------------------------------------------------- 标签页 */
QTabWidget::pane {
    border: none;
    background: transparent;
    top: 1px;
}

QTabBar::tab {
    background: transparent;
    color: #98a1b5;
    padding: 8px 16px;
    border: none;
    border-bottom: 2px solid transparent;
    margin-right: 2px;
    border-radius: 6px 6px 0 0;
    font-weight: 550;
}

QTabBar::tab:selected {
    color: #e6e9f2;
    border-bottom: 2px solid #7c8cf8;
    background: rgba(124, 140, 248, 0.08);
}

QTabBar::tab:hover:!selected {
    color: #c5cddd;
    background: rgba(230, 233, 242, 0.05);
}

QTabBar::close-button {
    image: none;
    subcontrol-position: right;
}

/* ---------------------------------------------------------- 状态栏 */
QStatusBar {
    background: #171a24;
    color: #98a1b5;
    border-top: 1px solid #2b3143;
}

QStatusBar QLabel {
    color: #98a1b5;
    padding: 0 8px;
}

/* ---------------------------------------------------------- 输入控件 */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background: #171a24;
    color: #e6e9f2;
    border: 1px solid rgba(43, 49, 67, 0.75);
    border-radius: 8px;
    padding: 6px 9px;
    selection-background-color: rgba(124, 140, 248, 0.28);
}

QLineEdit:focus, QSpinBox:focus, QComboBox:focus,
QPlainTextEdit:focus, QTextEdit:focus {
    border-color: rgba(124, 140, 248, 0.65);
    background: #12141c;
}

QComboBox::drop-down {
    border: none;
    width: 18px;
}

QComboBox QAbstractItemView {
    background: #1e222f;
    color: #e6e9f2;
    border: 1px solid #2b3143;
    border-radius: 8px;
    padding: 4px;
    selection-background-color: rgba(124, 140, 248, 0.18);
}

QTextEdit, QPlainTextEdit {
    background: #171a24;
    color: #e6e9f2;
    border: 1px solid rgba(43, 49, 67, 0.75);
    border-radius: 8px;
    padding: 6px;
    selection-background-color: rgba(124, 140, 248, 0.28);
}

/* ---------------------------------------------------------- 按钮 */
QPushButton {
    background: rgba(38, 43, 58, 0.55);
    color: #e6e9f2;
    border: 1px solid rgba(43, 49, 67, 0.8);
    border-radius: 8px;
    padding: 6px 14px;
    min-height: 20px;
    font-weight: 550;
}

QPushButton:hover {
    background: #262b3a;
    border-color: #39415a;
}

QPushButton:pressed {
    background: #1e222f;
}

QPushButton[primary="true"] {
    background: #7c8cf8;
    border: 1px solid rgba(124, 140, 248, 0.35);
    color: #12141c;
    font-weight: 650;
}

QPushButton[primary="true"]:hover {
    background: #98a5ff;
}

QPushButton[primary="true"]:pressed {
    background: #5f6fe8;
}

QPushButton:disabled {
    color: #5a6274;
    background: #171a24;
    border-color: #232839;
}

/* ---------------------------------------------------------- 分组框 */
QGroupBox {
    border: 1px solid rgba(43, 49, 67, 0.8);
    border-radius: 12px;
    margin-top: 12px;
    padding: 14px 10px 10px 10px;
    background: #1a1e29;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    color: #a5b1ff;
    font-weight: 650;
    background: #12141c;
}

/* ---------------------------------------------------------- 列表 */
QListWidget, QListView, QTreeView, QTableView {
    background: #171a24;
    color: #e6e9f2;
    border: 1px solid rgba(43, 49, 67, 0.8);
    border-radius: 12px;
    alternate-background-color: #1c202c;
    selection-background-color: rgba(124, 140, 248, 0.18);
    outline: 0;
    padding: 4px;
}

QListWidget::item {
    border-radius: 8px;
    padding: 2px;
}

QListWidget::item:hover {
    background: rgba(230, 233, 242, 0.06);
}

QListWidget::item:selected {
    background: rgba(124, 140, 248, 0.18);
}

QHeaderView::section {
    background: #1e222f;
    color: #98a1b5;
    border: none;
    border-bottom: 1px solid #2b3143;
    padding: 6px;
    font-weight: 550;
}

/* ---------------------------------------------------------- 菜单 */
QMenuBar {
    background: #171a24;
    color: #e6e9f2;
}

QMenuBar::item:selected {
    background: rgba(230, 233, 242, 0.08);
    border-radius: 6px;
}

QMenu {
    background: #1e222f;
    color: #e6e9f2;
    border: 1px solid rgba(43, 49, 67, 0.7);
    border-radius: 12px;
    padding: 6px;
}

QMenu::item {
    padding: 6px 16px;
    border-radius: 8px;
}

QMenu::item:selected {
    background: rgba(124, 140, 248, 0.18);
    color: #a5b1ff;
}

QMenu::separator {
    height: 1px;
    background: #2b3143;
    margin: 5px 8px;
}

/* ---------------------------------------------------------- 滚动条（极细） */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: rgba(152, 161, 181, 0.18);
    min-height: 28px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(152, 161, 181, 0.36);
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: rgba(152, 161, 181, 0.18);
    min-width: 28px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: rgba(152, 161, 181, 0.36);
}

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
}

/* ---------------------------------------------------------- 复选框 */
QCheckBox {
    color: #c5cddd;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #39415a;
    border-radius: 5px;
    background: #171a24;
}

QCheckBox::indicator:hover {
    border-color: rgba(124, 140, 248, 0.65);
}

QCheckBox::indicator:checked {
    background: #7c8cf8;
    border-color: #7c8cf8;
}

/* ---------------------------------------------------------- 提示 */
QToolTip {
    background: #1e222f;
    color: #e6e9f2;
    border: 1px solid rgba(43, 49, 67, 0.7);
    border-radius: 8px;
    padding: 6px 9px;
}

/* ---------------------------------------------------------- 对话区 */
QTextBrowser {
    background: #12141c;
    border: 1px solid rgba(43, 49, 67, 0.8);
    border-radius: 12px;
}

/* ---------------------------------------------------------- 设备库面板 */
QLabel#VaultTitle {
    color: #e6e9f2;
    font-weight: 650;
    font-size: 15px;
}

QLabel#VaultCount {
    color: #98a1b5;
    font-size: 11px;
}

QLabel#VaultSection {
    color: #a5b1ff;
    font-size: 11px;
    font-weight: 650;
    padding: 2px 0;
}

QLabel#VaultHint {
    color: #666e82;
    font-size: 10px;
}

QLineEdit#VaultSearch {
    background: #12141c;
    border: 1px solid rgba(43, 49, 67, 0.75);
    border-radius: 8px;
    padding: 5px 9px;
    color: #e6e9f2;
    font-size: 12px;
}

QLineEdit#VaultSearch:focus {
    border-color: rgba(124, 140, 248, 0.65);
}

QPushButton#VaultPrimaryBtn {
    background: #7c8cf8;
    color: #12141c;
    border: none;
    border-radius: 8px;
    padding: 5px 12px;
    font-weight: 650;
    min-height: 18px;
}

QPushButton#VaultPrimaryBtn:hover {
    background: #98a5ff;
}

QPushButton#VaultPrimaryBtn:pressed {
    background: #5f6fe8;
}

QScrollArea#VaultScroll {
    background: transparent;
    border: none;
}

QWidget#VaultCardsHost {
    background: transparent;
}

/* ---------------------------------------------------------- 菜单栏右上角开关 */
QPushButton#TopToggleBtn {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 3px 10px;
    margin-right: 6px;
    color: #c5cddd;
    font-size: 12px;
    font-weight: 550;
}

QPushButton#TopToggleBtn:hover {
    background: rgba(230, 233, 242, 0.08);
}

QPushButton#TopToggleBtn:checked {
    background: rgba(124, 140, 248, 0.16);
    border-color: rgba(124, 140, 248, 0.55);
    color: #a5b1ff;
}